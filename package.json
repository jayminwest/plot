{
	"name": "@os-eco/plot-cli",
	"version": "0.1.1",
	"description": "Typed, queryable, JSON-backed coordination object for multi-agent work",
	"type": "module",
	"bin": {
		"plot": "./src/index.ts"
	},
	"main": "src/index.ts",
	"files": ["src"],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.0.0"
	},
	"keywords": [
		"coordination",
		"multi-agent",
		"ai",
		"agents",
		"cli",
		"developer-tools"
	],
	"author": "Jaymin West",
	"license": "MIT",
	"homepage": "https://github.com/jayminwest/plot",
	"bugs": {
		"url": "https://github.com/jayminwest/plot/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jayminwest/plot.git"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"version:bump": "bun run scripts/version-bump.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/bun": "latest",
		"typescript": "^5.9.0"
	}
}
